{
 "language": "ta",
 "lines": {
  "1": "நேத்து ராத்திரி தூங்கப் போனேன், திடீர்னு ஞாபகம் வந்தது,",
  "2": "ஐயோ, ஸ்கின்கேர் பண்ணவே இல்ல,",
  "3": "இதை நான் ஸ்கிப் பண்ணவே மாட்டேன்,",
  "4": "கன்னத்துல ஸ்டப்பர்ன் ஸ்பாட்ஸ் இருந்தது,",
  "5": "இப்போ மெதுவா ஃபேட் ஆகற மாதிரி இருக்கு,",
  "6": "DERMDOC 2% Kojic Acid Night Cream,",
  "7": "போடுங்க, லைட் ஆஃப் பண்ணுங்க, தூங்குங்க,",
  "8": "ஸ்கின் தன் வேலையைச் செய்யட்டும்."
 }
